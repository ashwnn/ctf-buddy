# The event targets are Linux. A shell script or Python file that arrives with
# CRLF endings fails there in confusing ways ("bad interpreter: /usr/bin/env
# bash^M"), so normalise text to LF in the repository regardless of the
# contributor's platform.
* text=auto eol=lf

*.sh      text eol=lf
*.bash    text eol=lf
*.py      text eol=lf
*.php     text eol=lf
*.json    text eol=lf
*.jsonl   text eol=lf
*.md      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.conf    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.service text eol=lf
ctfctl    text eol=lf

*.pcap    binary
*.pcapng  binary
*.png     binary
*.jpg     binary
*.gz      binary
*.zip     binary
